# ===== 钉钉开放平台应用凭证（企业内部开发 -> 机器人应用）=====
# 开发者后台 open-dev.dingtalk.com -> 应用详情 -> 凭证与基础信息
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret

# ===== 重定向回调地址 =====
# 必须与开发者后台「安全设置 - 重定向URL」逐字一致
# 本地开发可用 http://localhost:3000/api/auth/callback（实测可通过）
DINGTALK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ===== 服务端口 =====
PORT=3000

# ===== 机器人自动发送的欢迎消息 =====
# {nick} 会被替换为授权识别到的用户昵称
ROBOT_WELCOME_MSG=你好{nick}，请发送您的问题？

# ===== 机器人的 chatbotUserId（加密ID，形如 $:LWCP_v1:$xxx）=====
# 留空时服务会自动从 .chatbot-user-id 文件读取（webhook 捕获后自动生成）
# 一般无需手填；仅在无法部署 webhook 时从回调消息体手动复制填写
DINGTALK_CHATBOT_USER_ID=
